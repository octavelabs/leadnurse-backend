NODE_ENV=development
PORT=5000

# PostgreSQL connection string (Neon or any PostgreSQL provider)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Cloudinary (file uploads - profile pictures & compliance documents)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (transactional emails)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Lead Nurse <onboarding@resend.dev>

# Shared secret for the external cron pinger hitting /api/internal/scheduled-checks
CRON_SECRET=generate_a_random_secret

# Fallback inbox for admin-facing notification emails (new applications, missed
# clock-outs); falls back to compliance@leadnurse.co.uk if unset
ADMIN_NOTIFY_EMAIL=
